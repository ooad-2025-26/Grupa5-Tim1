@page
@model RegisterModel

@{
    ViewData["Title"] = "Registracija";
}

<div class="auth-container">

    <h1 class="auth-title">Registracija</h1>

    <form id="registerForm"
          asp-route-returnUrl="@Model.ReturnUrl"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger">
        </div>

        <div class="auth-row">

            <div class="auth-field">
                <label asp-for="Input.Ime"></label>
                <input asp-for="Input.Ime" class="auth-input" />
                <span asp-validation-for="Input.Ime" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Prezime"></label>
                <input asp-for="Input.Prezime" class="auth-input" />
                <span asp-validation-for="Input.Prezime" class="text-danger"></span>
            </div>

        </div>

        <div class="auth-field">
            <label asp-for="Input.BrojClanskeKartice"></label>
            <input asp-for="Input.BrojClanskeKartice" class="auth-input" />
            <span asp-validation-for="Input.BrojClanskeKartice" class="text-danger"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" class="auth-input" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="auth-input" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" class="auth-input" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button id="registerSubmit"
                type="submit"
                class="auth-button">
            Sign up
        </button>

        <div class="auth-footer">
            Imate račun?
            <a asp-page="./Login">Prijavite se</a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}