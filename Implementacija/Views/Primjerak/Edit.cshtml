@model bibliotecha.Models.Primjerak

@{
    ViewData["Title"] = "Uredi primjerak";
}

<h1>Uredi primjerak #@Model.IdPrimjerka</h1>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdPrimjerka" />
            <div class="mb-3">
                <label asp-for="KnjigaId" class="form-label">Knjiga</label>
                <select asp-for="KnjigaId" class="form-select" asp-items="ViewBag.KnjigaId"></select>
                <span asp-validation-for="KnjigaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusPrimjerka>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Sačuvaj izmjene</button>
            <a asp-controller="Knjiga" asp-action="Index" class="btn btn-link">Odustani</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}