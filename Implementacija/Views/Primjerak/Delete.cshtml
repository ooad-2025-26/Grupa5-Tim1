@model bibliotecha.Models.Primjerak

@{
    ViewData["Title"] = "Obriši primjerak";
}

<h1>Obriši primjerak</h1>

<h3>Da li ste sigurni da želite obrisati ovaj primjerak?</h3>
<div>
    <h4>Primjerak</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Knjiga)
        </dt>
        <dd class="col-sm-10">
            @Model.Knjiga.Naslov
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdPrimjerka" />
        <input type="submit" value="Obriši primjerak" class="btn btn-danger" />
        <a asp-controller="Knjiga" asp-action="Index" class="btn btn-link">Odustani</a>
    </form>
</div>