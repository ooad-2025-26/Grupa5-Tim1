@model bibliotecha.Models.Primjerak

@{
    ViewData["Title"] = "Dodaj primjerak";
}

<div class="book-form-header book-form-header--compact">
    <div>
        <h1>Dodaj novi primjerak</h1>
        <p>Evidentirajte novu fizičku kopiju knjige u bibliotečkom fondu.</p>
    </div>
</div>

<div class="book-form-card book-form-card--compact">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-group mb-4">
            <label asp-for="KnjigaId" class="form-label">Knjiga</label>
            <select asp-for="KnjigaId" class="form-select" asp-items="ViewBag.KnjigaId">
                <option value="">Odaberite knjigu</option>
            </select>
            <span asp-validation-for="KnjigaId" class="text-danger"></span>
            <small class="text-muted">
                Odaberite naslov kojem pripada novi fizički primjerak.
            </small>
        </div>

        <div class="form-group">
            <label asp-for="Status" class="form-label">Početni status</label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StatusPrimjerka>()"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
            <small class="text-muted">
                Novi primjerak se uobičajeno evidentira kao dostupan.
            </small>
        </div>

        <div class="book-form-actions">
            <button type="submit" class="btn btn-primary">Dodaj primjerak</button>
            <a asp-controller="Knjiga" asp-action="Index" class="btn btn-outline-secondary">
                Odustani
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}