@model IEnumerable<bibliotecha.Models.Knjiga>

@{
    ViewData["Title"] = "Upravljanje katalogom";
}

<div class="management-header">
    <div>
        <h1>Upravljanje knjigama i primjercima</h1>
        <p>Pregled i održavanje kataloga i fizičkih primjeraka knjiga.</p>
    </div>
    <div class="management-actions">
        <a asp-action="Create" class="btn btn-primary">Dodaj novu knjigu</a>
        <a asp-controller="Primjerak" asp-action="Create" class="btn btn-outline-primary">Dodaj novi primjerak</a>
    </div>
</div>

<form asp-action="Index" method="get" class="management-search">
    <input type="text"
           name="q"
           value="@ViewData["Upit"]"
           placeholder="Pretraži po naslovu, autoru ili ISBN-u..."
           autocomplete="off" />
    <button type="submit" class="btn btn-primary">Pretraži</button>
    @if (!string.IsNullOrWhiteSpace(ViewData["Upit"]?.ToString()))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Očisti</a>
    }
</form>

@if (TempData["Poruka"] is string poruka)
{
    <div class="alert alert-success">@poruka</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Nema knjiga koje odgovaraju pretrazi.</div>
}

@foreach (var knjiga in Model)
{
    var dostupno = knjiga.Primjerci.Count(p => p.Status == StatusPrimjerka.Dostupan);

    <section class="management-card">
        <div class="catalog-summary">
            <div>
                <h2>@knjiga.Naslov</h2>
                <p>@knjiga.Autor.Ime @knjiga.Autor.Prezime</p>
                <small>ISBN: @knjiga.ISBN | @knjiga.Zanr</small>
            </div>
            <div class="management-badges">
                <span><strong>@knjiga.Primjerci.Count</strong> ukupno</span>
                <span><strong>@dostupno</strong> dostupno</span>
            </div>
            <div class="management-actions">
                <a asp-action="Details" asp-route-id="@knjiga.IdKnjige" class="btn btn-sm btn-outline-secondary">Detalji</a>
                <a asp-action="Edit" asp-route-id="@knjiga.IdKnjige" class="btn btn-sm btn-outline-primary">Uredi knjigu</a>
                <a asp-controller="Primjerak" asp-action="Create" asp-route-knjigaId="@knjiga.IdKnjige"
                   class="btn btn-sm btn-primary">Dodaj primjerak</a>
                <a asp-action="Delete" asp-route-id="@knjiga.IdKnjige" class="btn btn-sm btn-outline-danger">Obriši knjigu</a>
            </div>
        </div>

        @if (knjiga.Primjerci.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Interni ID primjerka</th>
                            <th>Status</th>
                            <th class="text-end">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var primjerak in knjiga.Primjerci.OrderBy(p => p.IdPrimjerka))
                        {
                            <tr>
                                <td>#@primjerak.IdPrimjerka</td>
                                <td><span class="status-badge status-badge--@primjerak.Status.ToString().ToLowerInvariant()">@primjerak.Status</span></td>
                                <td class="text-end">
                                    <a asp-controller="Primjerak" asp-action="Details" asp-route-id="@primjerak.IdPrimjerka" class="btn btn-sm btn-link">Detalji</a>
                                    <a asp-controller="Primjerak" asp-action="Edit" asp-route-id="@primjerak.IdPrimjerka" class="btn btn-sm btn-link">Uredi</a>
                                    <a asp-controller="Primjerak" asp-action="Delete" asp-route-id="@primjerak.IdPrimjerka" class="btn btn-sm btn-link text-danger">Obriši</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="management-empty">
                Ova knjiga nema evidentiranih primjeraka.
                <a asp-controller="Primjerak" asp-action="Create" asp-route-knjigaId="@knjiga.IdKnjige">Dodaj prvi primjerak</a>.
            </div>
        }
    </section>
}
