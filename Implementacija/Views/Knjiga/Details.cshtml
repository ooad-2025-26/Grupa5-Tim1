@model bibliotecha.Models.Knjiga
@{
    ViewData["Title"] = Model.Naslov;
    var korica = string.IsNullOrWhiteSpace(Model.KoricaKnjige)
        ? Url.Content("~/images/book-placeholder.svg")
        : Model.KoricaKnjige;
    var brojDostupnihPrimjeraka = Model.Primjerci.Count(p => p.Status == StatusPrimjerka.Dostupan);
}
<section class="book-details">
    <div class="book-details__left">
        <img class="book-details__cover" src="@korica" alt="Korica knjige @Model.Naslov" />
        @if (User.IsInRole("Bibliotekar") || User.IsInRole("Administrator"))
        {
            <a class="book-details__button"
               asp-action="Edit"
               asp-route-id="@Model.IdKnjige">
                Uredi knjigu
            </a>
        }
        else
        {
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Posudba"
                      asp-action="Posudi"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="knjigaId" value="@Model.IdKnjige" />
                    <button type="submit" class="book-details__button">
                        Posudi
                    </button>
                </form>
            }
            else
            {
                <a class="book-details__button"
                   asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-returnUrl="@Url.Action("Details", "Knjiga", new { id = Model.IdKnjige })">
                    Posudi
                </a>
            }

            @if (ViewData["ImaAktivnuPosudbu"] as bool? == true)
            {
                <form asp-controller="Posudba"
                      asp-action="Produzi"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="knjigaId" value="@Model.IdKnjige" />
                    <button type="submit" class="book-details__button">
                        Produži posudbu
                    </button>
                </form>
            }
        }
    </div>
    <div class="book-details__info">
        <h1>@Model.Naslov</h1>
        <h2>
            @Model.Autor?.Ime @Model.Autor?.Prezime
        </h2>
        <div class="book-details__rating">

            <span class="rating-stars">
                @{
                    int brojZvjezdica =
                        (int)Math.Round(Model.ProsjecnaOcjena,
                                        MidpointRounding.AwayFromZero);
                }

                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= brojZvjezdica)
                    {
                        <span>★</span>
                    }
                    else
                    {
                        <span>☆</span>
                    }
                }
            </span>

            <span class="rating-value">
                @Model.ProsjecnaOcjena.ToString(
                    "0.00",
                    System.Globalization.CultureInfo.InvariantCulture)
            </span>

        </div>

        <p class="book-details__availability">
            Dostupnih primjeraka: @brojDostupnihPrimjeraka
        </p>
        <p class="book-details__description">
            @Model.Opis
        </p>
        <p class="book-details__meta">
            @Model.Zanr · @Model.Jezik jezik · @Model.BrojStranica stranica
        </p>
        <p class="book-details__meta">
            @Model.DatumIzdavanja.Year · @Model.Izdavac
        </p>
        @if (User.IsInRole("Bibliotekar") || User.IsInRole("Administrator"))
        {
            <div class="book-details__links">
                <a asp-action="Edit" asp-route-id="@Model.IdKnjige">Uredi</a>
            </div>
        }
    </div>
</section>
@if (TempData["Poruka"] != null)
{
    <div class="custom-popup">
        <div class="custom-popup__box">
            <p>@TempData["Poruka"]</p>
            <button type="button" onclick="this.closest('.custom-popup').remove()">
                U redu
            </button>
        </div>
    </div>
}
@if (TempData["NemaDostupnihPrimjeraka"] != null)
{
    <div class="custom-popup">
        <div class="custom-popup__box">
            <p>Knjiga nije dostupna za posudbu. Želite li izvršiti rezervaciju?</p>
            <div class="custom-popup__actions">
                <form asp-controller="Rezervacijas"
                      asp-action="Rezervisi"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="knjigaId" value="@Model.IdKnjige" />
                    <button type="submit">Da</button>
                </form>
                <button type="button" onclick="this.closest('.custom-popup').remove()">
                    Ne
                </button>
            </div>
        </div>
    </div>
}
