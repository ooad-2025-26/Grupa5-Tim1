@model bibliotecha.Models.Posudba

@{
    ViewData["Title"] = "Nova posudba";
}

<div class="book-form-header">
    <div>
        <h1>Nova posudba</h1>
        <p>Evidentiranje fizičke posudbe knjige u biblioteci.</p>
    </div>
</div>

<div class="book-form-card">

    <form asp-action="Create">

        <div asp-validation-summary="All"
             class="alert alert-danger">
        </div>

        <div class="book-form-grid">

            <div class="form-group">
                <label asp-for="KorisnikId"
                       class="form-label">
                    Korisnik
                </label>

                <select asp-for="KorisnikId"
                        class="form-select"
                        asp-items="ViewBag.KorisnikId">
                </select>

                <span asp-validation-for="KorisnikId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="PrimjerakId"
                       class="form-label">
                    Primjerak knjige
                </label>

                <select asp-for="PrimjerakId"
                        class="form-select"
                        asp-items="ViewBag.PrimjerakId">
                </select>

                <span asp-validation-for="PrimjerakId"
                      class="text-danger">
                </span>
            </div>

        </div>

        <div class="book-form-actions">

            <input type="submit"
                   value="Evidentiraj posudbu"
                   class="btn btn-primary" />

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Odustani
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}