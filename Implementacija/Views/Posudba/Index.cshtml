@model IEnumerable<bibliotecha.Models.Posudba>

@{
    ViewData["Title"] = "Evidencija posudbi";
}

<div class="management-header">
    <div>
        <h1>Evidencija posudbi</h1>
        <p>Pregled svih aktivnih i završenih posudbi.</p>
    </div>

    <div class="management-actions">
        <a asp-action="Create"
           class="btn btn-primary">
            Dodaj novu posudbu
        </a>

        <a asp-controller="Rezervacijas"
           asp-action="Index"
           class="btn btn-outline-primary">
            Evidencija rezervacija
        </a>
    </div>
</div>

<form asp-action="Index"
      method="get"
      class="management-search">

    <input type="text"
           name="q"
           value="@ViewData["Upit"]"
           placeholder="Pretraži po naslovu, autoru, ISBN-u ili korisniku..."
           autocomplete="off" />

    <button type="submit"
            class="btn btn-primary">
        Pretraži
    </button>

    @if (!string.IsNullOrWhiteSpace(ViewData["Upit"]?.ToString()))
    {
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Očisti
        </a>
    }
</form>

@if (TempData["Poruka"] is string poruka)
{
    <div class="alert alert-success">
        @poruka
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nema evidentiranih posudbi.
    </div>
}

@foreach (var posudba in Model)
{
    <section class="management-card">

        <div class="catalog-summary">

            <div>
                <h2>@posudba.Primjerak.Knjiga.Naslov</h2>

                <p>
                    @posudba.Primjerak.Knjiga.Autor.Ime
                    @posudba.Primjerak.Knjiga.Autor.Prezime
                </p>

                <small>
                    ISBN: @posudba.Primjerak.Knjiga.ISBN |
                    @posudba.Primjerak.Knjiga.Zanr
                </small>
            </div>

            <div class="management-badges">
                <span>
                    <strong>Primjerak:</strong>
                    #@posudba.PrimjerakId
                </span>

                <span>
                    <strong>Korisnik:</strong>
                    @posudba.Korisnik.Ime
                    @posudba.Korisnik.Prezime
                </span>

                <span>
                    <strong>Status:</strong>
                    @posudba.Status
                </span>
            </div>

            <div class="management-actions">

                @if (posudba.Status == StatusPosudbe.Online)
                {
                    <a asp-action="Preuzmi"
                       asp-route-id="@posudba.IdPosudbe"
                       class="btn btn-sm btn-success">
                        Preuzmi
                    </a>
                }

                @if (posudba.Status != StatusPosudbe.Zavrsena)
                {
                    <a asp-action="Vrati"
                       asp-route-id="@posudba.IdPosudbe"
                       class="btn btn-sm btn-warning">
                        Vrati
                    </a>
                }

                <a asp-action="Details"
                   asp-route-id="@posudba.IdPosudbe"
                   class="btn btn-sm btn-outline-secondary">
                    Detalji
                </a>
            </div>

        </div>

    </section>
}