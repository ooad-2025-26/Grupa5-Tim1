@model bibliotecha.Models.Posudba

@{
    ViewData["Title"] = "Detalji posudbe";
}

<div class="book-form-header book-form-header--compact">
    <div>
        <h1>Detalji posudbe</h1>
        <p>Pregled podataka o odabranoj posudbi.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Nazad na evidenciju
    </a>
</div>


<div class="book-form-card book-form-card--compact">

    <div class="book-form-grid">


        <div class="form-group">
            <label class="form-label">
                Knjiga
            </label>

            <div class="form-control">
                @Model.Primjerak.Knjiga.Naslov
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Primjerak
            </label>

            <div class="form-control">
                #@Model.Primjerak.IdPrimjerka
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Korisnik
            </label>

            <div class="form-control">
                @Model.Korisnik.Ime @Model.Korisnik.Prezime
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Datum online posudbe
            </label>

            <div class="form-control">
                @Model.DatumOnlinePosudbe
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Datum preuzimanja
            </label>

            <div class="form-control">
                @(Model.DatumPreuzimanja?.ToString() ?? "-")
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Rok vraćanja
            </label>

            <div class="form-control">
                @Model.RokVracanja
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Status
            </label>

            <div class="form-control">
                @Model.Status
            </div>
        </div>


        <div class="form-group">
            <label class="form-label">
                Broj produženja
            </label>

            <div class="form-control">
                @Model.BrojProduzenja
            </div>
        </div>


    </div>


    <div class="book-form-actions">

        @if (User.IsInRole("Bibliotekar") || User.IsInRole("Administrator"))
        {
            <a asp-controller="Posudba"
               asp-action="Edit"
               asp-route-id="@Model.IdPosudbe"
               class="btn btn-primary">
                Uredi posudbu
            </a>
        }

        <a asp-controller="Posudba"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Nazad na evidenciju
        </a>

    </div>

</div>