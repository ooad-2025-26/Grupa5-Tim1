@model bibliotecha.Models.Posudba

@{
    ViewData["Title"] = "Uredi posudbu";
}

<div class="book-form-header">
    <div>
        <h1>Uredi posudbu</h1>
        <p>Izmijenite podatke postojeće posudbe.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Nazad na evidenciju
    </a>
</div>


<div class="book-form-card">

    <form asp-action="Edit" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <input type="hidden" asp-for="IdPosudbe" />


        <div class="book-form-grid">


            <div class="form-group">

                <label asp-for="PrimjerakId"
                       class="form-label">
                    Primjerak
                </label>

                <select asp-for="PrimjerakId"
                        class="form-select"
                        asp-items="ViewBag.PrimjerakId">
                </select>

                <span asp-validation-for="PrimjerakId"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="KorisnikId"
                       class="form-label">
                    Korisnik
                </label>

                <select asp-for="KorisnikId"
                        class="form-select"
                        asp-items="ViewBag.KorisnikId">
                </select>

                <span asp-validation-for="KorisnikId"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="DatumOnlinePosudbe"
                       class="form-label">
                    Datum online posudbe
                </label>

                <input asp-for="DatumOnlinePosudbe"
                       class="form-control" />

                <span asp-validation-for="DatumOnlinePosudbe"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="DatumPreuzimanja"
                       class="form-label">
                    Datum preuzimanja
                </label>

                <input asp-for="DatumPreuzimanja"
                       class="form-control" />

                <span asp-validation-for="DatumPreuzimanja"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="RokVracanja"
                       class="form-label">
                    Rok vraćanja
                </label>

                <input asp-for="RokVracanja"
                       class="form-control" />

                <span asp-validation-for="RokVracanja"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Status"
                       class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<StatusPosudbe>()">
                </select>

                <span asp-validation-for="Status"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="BrojProduzenja"
                       class="form-label">
                    Broj produženja
                </label>

                <input asp-for="BrojProduzenja"
                       class="form-control" />

                <span asp-validation-for="BrojProduzenja"
                      class="text-danger">
                </span>

            </div>


        </div>


        <div class="book-form-actions">

            <button type="submit"
                    class="btn btn-primary">
                Sačuvaj izmjene
            </button>


            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Odustani
            </a>

        </div>


    </form>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}