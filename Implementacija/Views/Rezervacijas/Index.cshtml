@model IEnumerable<bibliotecha.Models.Rezervacija>

@{
    ViewData["Title"] = "Evidencija rezervacija";
}

<div class="management-header">
    <div>
        <h1>Evidencija rezervacija</h1>
        <p>Pregled svih rezervacija knjiga.</p>
    </div>

    <div class="management-actions">
        <a asp-controller="Posudba"
           asp-action="Index"
           class="btn btn-outline-primary">
            Evidencija posudbi
        </a>
    </div>
</div>

<form asp-action="Index"
      method="get"
      class="management-search">

    <input type="text"
           name="q"
           value="@ViewData["Upit"]"
           placeholder="Pretraži po naslovu, autoru, ISBN-u ili korisniku..."
           autocomplete="off" />

    <button type="submit"
            class="btn btn-primary">
        Pretraži
    </button>

    @if (Context.Request.Query.ContainsKey("q"))
    {
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Očisti
        </a>
    }
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nema rezervacija.
    </div>
}

@foreach (var rezervacija in Model)
{
    <section class="management-card">

        <div class="catalog-summary">

            <div>
                <h2>@rezervacija.Knjiga.Naslov</h2>

                <p>
                    @rezervacija.Knjiga.Autor.Ime
                    @rezervacija.Knjiga.Autor.Prezime
                </p>

                <small>
                    ISBN: @rezervacija.Knjiga.ISBN |
                    @rezervacija.Knjiga.Zanr
                </small>
            </div>

            <div class="management-badges">

                <span>
                    <strong>Korisnik:</strong>
                    @rezervacija.Korisnik.Ime
                    @rezervacija.Korisnik.Prezime
                </span>

                <span>
                    <strong>Pozicija:</strong>
                    @rezervacija.PozicijaURedu
                </span>

                <span>
                    <strong>Status:</strong>

                    @{
                        var display = rezervacija.Status
                            .GetType()
                            .GetMember(rezervacija.Status.ToString())[0]
                            .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                            .FirstOrDefault() as System.ComponentModel.DataAnnotations.DisplayAttribute;
                    }

                    @(display?.Name ?? rezervacija.Status.ToString())
                </span>

            </div>

            <div class="management-actions">

                @if (rezervacija.Status == StatusRezervacije.spremnaZaPreuzimanje)
                {
                    <a asp-action="Preuzmi"
                       asp-route-id="@rezervacija.IdRezervacije"
                       class="btn btn-sm loan-btn loan-btn--preuzmi">
                        Preuzmi
                    </a>
                }


                <a asp-action="Details"
                   asp-route-id="@rezervacija.IdRezervacije"
                   class="btn btn-sm btn-outline-secondary">
                    Detalji
                </a>

            </div>

        </div>

    </section>
}